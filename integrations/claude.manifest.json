{
  "agent": "claude",
  "displayName": "Claude Code",
  "detect": {
    "command": "claude"
  },
  "native": {
    "kind": "plugin",
    "install": [
      "/plugin marketplace add $EXTERNAL_AGENTS_HOME",
      "/plugin install external-agents@external-agents"
    ]
  },
  "fallback": {
    "kind": "symlink",
    "global": {
      "link": "~/.claude/skills/external-agents",
      "target": "$EXTERNAL_AGENTS_HOME/skills/external-agents"
    },
    "project": {
      "link": "<project>/.claude/skills/external-agents",
      "target": "$EXTERNAL_AGENTS_HOME/skills/external-agents"
    }
  },
  "entry": "skills/external-agents/SKILL.md"
}
